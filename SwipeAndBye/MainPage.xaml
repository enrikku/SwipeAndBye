<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SwipeAndBye.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:clases="clr-namespace:SwipeAndBye.Clases"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="Black">
    <Grid>

        <Grid ColumnDefinitions="*" RowDefinitions="Auto,*">

            <!--  HEADER  -->
            <Border
                Margin="12"
                Padding="16"
                BackgroundColor="#FFFFFF"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0">

                <Border.Shadow>
                    <Shadow
                        Brush="#22000000"
                        Opacity="0.4"
                        Radius="12"
                        Offset="0,4" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">

                    <Grid
                        ColumnDefinitions="*,Auto,*,Auto,*"
                        ColumnSpacing="12"
                        RowDefinitions="Auto"
                        VerticalOptions="Center">

                        <!--  Fotos  -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontSize="12"
                                HorizontalTextAlignment="Center"
                                Text="Fotos"
                                TextColor="#888888" />

                            <Label
                                x:Name="LblFotosEncontradas"
                                FontAttributes="Bold"
                                FontSize="26"
                                HorizontalTextAlignment="Center"
                                Text="0"
                                TextColor="#111111" />
                        </VerticalStackLayout>

                        <!--  Separador  -->
                        <BoxView
                            Grid.Column="1"
                            BackgroundColor="#EEEEEE"
                            VerticalOptions="Fill"
                            WidthRequest="1" />

                        <!--  Eliminadas  -->
                        <VerticalStackLayout
                            Grid.Column="2"
                            HorizontalOptions="Center"
                            Spacing="4">

                            <Label
                                FontSize="12"
                                HorizontalTextAlignment="Center"
                                Text="Eliminadas"
                                TextColor="#888888" />

                            <Label
                                x:Name="LblEliminadas"
                                FontAttributes="Bold"
                                FontSize="26"
                                HorizontalTextAlignment="Center"
                                Text="0"
                                TextColor="#E74C3C" />
                        </VerticalStackLayout>

                        <!--  Separador  -->
                        <BoxView
                            Grid.Column="3"
                            BackgroundColor="#EEEEEE"
                            VerticalOptions="Fill"
                            WidthRequest="1" />

                        <!--  Liberado  -->
                        <VerticalStackLayout
                            Grid.Column="4"
                            HorizontalOptions="Center"
                            Spacing="4">

                            <Label
                                FontSize="12"
                                HorizontalTextAlignment="Center"
                                Text="Liberado"
                                TextColor="#888888" />

                            <Label
                                x:Name="LblAhorro"
                                FontAttributes="Bold"
                                FontSize="20"
                                HorizontalTextAlignment="Center"
                                Text="0 B"
                                TextColor="#2ECC71" />
                        </VerticalStackLayout>
                    </Grid>

                    <!--  Papelera: solo aparece si queda algo por purgar  -->
                    <VerticalStackLayout
                        x:Name="PanelPapelera"
                        IsVisible="False"
                        Spacing="12">

                        <BoxView BackgroundColor="#EEEEEE" HeightRequest="1" />

                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontSize="12"
                                Text="En la papelera"
                                TextColor="#888888" />

                            <Label
                                x:Name="LblPapelera"
                                FontAttributes="Bold"
                                FontSize="16"
                                TextColor="#111111" />
                        </VerticalStackLayout>

                        <!--  A dos columnas iguales: "Recuperar todo" no cabe al lado del texto  -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                            <Button
                                x:Name="BtnRecuperar"
                                Padding="8,0"
                                BackgroundColor="#2ECC71"
                                Clicked="BtnRecuperar_OnClicked"
                                CornerRadius="18"
                                FontSize="14"
                                HeightRequest="38"
                                Text="Recuperar todo"
                                TextColor="White" />

                            <Button
                                x:Name="BtnVaciar"
                                Grid.Column="1"
                                Padding="8,0"
                                BackgroundColor="#E74C3C"
                                Clicked="BtnVaciar_OnClicked"
                                CornerRadius="18"
                                FontSize="14"
                                HeightRequest="38"
                                Text="Vaciar"
                                TextColor="White" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <RefreshView
                x:Name="Refresco"
                Grid.Row="1"
                Refreshing="Refresco_OnRefreshing">
                <CollectionView x:Name="cv">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="clases:GrupoAño">

                            <!--  EXPANDER AÑO  -->
                            <toolkit:Expander>
                                <toolkit:Expander.Header>
                                    <Grid Padding="16,10">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="18"
                                            Text="{Binding Año}"
                                            TextColor="White" />

                                        <Label
                                            HorizontalOptions="End"
                                            Text="{Binding Count, StringFormat='({0})'}"
                                            TextColor="#AAAAAA" />
                                    </Grid>
                                </toolkit:Expander.Header>

                                <FlexLayout
                                    Padding="6,0,6,12"
                                    BindableLayout.ItemsSource="{Binding Meses}"
                                    JustifyContent="Start"
                                    Wrap="Wrap">

                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="clases:GrupoMes">

                                            <Grid
                                                Padding="6"
                                                FlexLayout.Basis="50%"
                                                SemanticProperties.Description="{Binding Descripcion}"
                                                SemanticProperties.Hint="Abre la revisión de este mes">

                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_OnTapped" />
                                                </Grid.GestureRecognizers>

                                                <VerticalStackLayout Spacing="6">

                                                    <!--  Miniatura  -->
                                                    <Border
                                                        BackgroundColor="#1E1E1E"
                                                        HeightRequest="100"
                                                        StrokeShape="RoundRectangle 10"
                                                        StrokeThickness="0">

                                                        <Image
                                                            Aspect="AspectFill"
                                                            HeightRequest="100"
                                                            Source="{Binding Miniatura}" />
                                                    </Border>

                                                    <!--  Mes  -->
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="14"
                                                        HorizontalTextAlignment="Center"
                                                        Text="{Binding NombreMes}"
                                                        TextColor="White" />

                                                    <!--  Count  -->
                                                    <Label
                                                        FontSize="12"
                                                        HorizontalTextAlignment="Center"
                                                        Text="{Binding Count, StringFormat='{0} fotos'}"
                                                        TextColor="#888888" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </toolkit:Expander>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!--  Solo se muestra tras un escaneo que no ha encontrado nada  -->
            <VerticalStackLayout
                x:Name="PanelVacio"
                Grid.Row="1"
                Padding="32"
                HorizontalOptions="Center"
                IsVisible="False"
                Spacing="8"
                VerticalOptions="Center">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalTextAlignment="Center"
                    Text="No se han encontrado fotos"
                    TextColor="White" />

                <Label
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    Text="Desliza hacia abajo para volver a buscar."
                    TextColor="#888888" />
            </VerticalStackLayout>
        </Grid>

        <Border
            x:Name="BorderIndicator"
            Padding="24"
            BackgroundColor="#CC000000"
            HorizontalOptions="Center"
            IsVisible="False"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="0"
            VerticalOptions="Center"
            WidthRequest="260">

            <Border.Shadow>
                <Shadow
                    Brush="#22000000"
                    Opacity="0.4"
                    Radius="12"
                    Offset="0,4" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">

                <ActivityIndicator
                    x:Name="Indicator"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    IsRunning="True"
                    IsVisible="True"
                    WidthRequest="40"
                    Color="White" />

                <!--  No hay porcentaje: el total no se sabe hasta acabar de recorrer el disco  -->
                <Label
                    x:Name="LblProgreso"
                    FontAttributes="Bold"
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    Text="Buscando fotos…"
                    TextColor="White" />

                <Label
                    x:Name="LblProgresoCarpeta"
                    FontSize="11"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    TextColor="#AAAAAA" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
